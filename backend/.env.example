# Server Configuration
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
BACKEND_URL=https://api.yourdomain.com
CLIENT_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=inventory_db
DB_SSL=true
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Production Cloud Database Connection String (optional, e.g. Neon, Supabase, Railway, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:5432/inventory_db?sslmode=require

# Logging
LOG_LEVEL=info
