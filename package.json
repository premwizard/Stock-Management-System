{
  "name": "stock-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory Management and Smart Stock Lookup System",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm --prefix backend run start",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

